APP_NAME="CNPJ Reader API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Local development only. Replace these values outside a local environment.
DOCKER_DB_DATABASE=cnpj_reader
DOCKER_DB_USERNAME=cnpj
DOCKER_DB_PASSWORD=cnpj_local_password
DOCKER_DB_ROOT_PASSWORD=local_root_password
